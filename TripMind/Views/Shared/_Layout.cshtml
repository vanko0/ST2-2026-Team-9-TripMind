<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TripMind</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TripMind.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />
</head>
<body>
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        var action = ViewContext.RouteData.Values["action"]?.ToString();
        bool isHome = controller == "Home" && action == "Index";
        bool isFlights = controller == "Trips" && action != "Log";
        bool isLogs = controller == "Trips" && action == "Log";
    }

    <header>
        <nav class="navbar navbar-expand-sm tm-navbar">
            <div class="container">
                <a class="navbar-brand tm-brand" asp-controller="Home" asp-action="Index">
                    ✈ TripMind
                </a>
                <button class="navbar-toggler tm-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#tmNav" aria-controls="tmNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-end" id="tmNav">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link tm-link @(isHome ? "active" : "")"
                               asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link tm-link @(isFlights ? "active" : "")"
                               asp-controller="Trips" asp-action="Index">My Flights</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link tm-link @(isLogs ? "active" : "")"
                               asp-controller="Trips" asp-action="Log">Logs</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="tm-footer">
        <div class="container">
            &copy; 2026 - TripMind
        </div>
    </footer>

    <partial name="_ChatWidget" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/chat.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>